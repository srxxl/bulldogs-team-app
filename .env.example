# --- Database -------------------------------------------------------------
# Local: the database `pnpm dev` starts (PGlite, data in .data/). Production: Vercel sets the Neon URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# --- Auth (Better Auth) ---------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, https://<your-app>.vercel.app in production
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra admin center → App registrations (any org + personal accounts)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Comma-separated emails of people who run the app (approvals, fixture, settings).
# They join as approved players with admin access. Coaches don't need to be admins.
ADMIN_EMAILS=

# Local only: email/password login + seeded demo accounts (ignored in production)
ENABLE_DEV_LOGIN=true

# --- Vercel ---------------------------------------------------------------
# Any long random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
# Vercel Blob store token (photos + pin images). Unset locally → public/uploads
BLOB_READ_WRITE_TOKEN=

# --- PlayHQ (optional, from the club's PlayHQ admin) ----------------------
PLAYHQ_API_KEY=
PLAYHQ_TEAM_ID=
PLAYHQ_GRADE_ID=
