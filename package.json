{
  "name": "bbfc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/server/db/seed.ts",
    "vercel-build": "pnpm db:migrate && next build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.12",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  }
}
